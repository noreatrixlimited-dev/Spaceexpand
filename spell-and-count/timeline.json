 "subs": [
  {
   "t0": 1.4,
   "t1": 3.3,
   "text": "Come on, friends!"
  },
  {
   "t0": 3.4,
   "t1": 5.7,
   "text": "Let's spell and count!"
  },
  {
   "t0": 5.8,
   "t1": 7.6,
   "text": "Letters first,"
  },
  {
   "t0": 7.7,
   "t1": 10.4,
   "text": "then say the number!"
  },
  {
   "t0": 33.131,
   "t1": 35.36,
   "text": "One bright sun"
  },
  {
   "t0": 35.36,
   "t1": 37.489,
   "text": "shining for everyone!"
  },
  {
   "t0": 50.964,
   "t1": 53.193,
   "text": "Two little birds"
  },
  {
   "t0": 53.193,
   "t1": 55.322,
   "text": "sing tweet tweet too!"
  },
  {
   "t0": 55.422,
   "t1": 57.651,
   "text": "Spell it! Say it!"
  },
  {
   "t0": 57.651,
   "t1": 59.831,
   "text": "Count with me!"
  },
  {
   "t0": 59.881,
   "t1": 62.06,
   "text": "ONE, TWO, THREE!"
  },
  {
   "t0": 62.06,
   "t1": 64.639,
   "text": "Learning numbers is so much fun!"
  },
  {
   "t0": 86.63,
   "t1": 88.859,
   "text": "Three red apples"
  },
  {
   "t0": 88.859,
   "t1": 90.988,
   "text": "on the tree!"
  },
  {
   "t0": 104.463,
   "t1": 106.692,
   "text": "Four little kittens"
  },
  {
   "t0": 106.692,
   "t1": 108.821,
   "text": "play on the floor!"
  },
  {
   "t0": 108.921,
   "t1": 111.15,
   "text": "Spell it! Say it!"
  },
  {
   "t0": 111.15,
   "t1": 113.329,
   "text": "Count with me!"
  },
  {
   "t0": 113.379,
   "t1": 115.558,
   "text": "ONE, TWO, THREE, FOUR!"
  },
  {
   "t0": 115.558,
   "t1": 118.038,
   "text": "Learning numbers is so much fun!"
  },
  {
   "t0": 187.5,
   "t1": 189.6,
   "text": "Spell it! Say it!"
  },
  {
   "t0": 189.7,
   "t1": 191.8,
   "text": "Count again!"
  },
  {
   "t0": 191.9,
   "t1": 195.9,
   "text": "ONE, TWO, THREE, FOUR, FIVE, SIX!"
  },
  {
   "t0": 196.0,
   "t1": 200.2,
   "text": "SEVEN, EIGHT, NINE, TEN!"
  },
  {
   "t0": 200.3,
   "t1": 202.4,
   "text": "We can spell!"
  },
  {
   "t0": 202.5,
   "t1": 204.3,
   "text": "We can count!"
  },
  {
   "t0": 204.3,
   "t1": 206.6,
   "text": "Yay!"
  }
